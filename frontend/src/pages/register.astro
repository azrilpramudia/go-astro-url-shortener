---
import Layout from "../layouts/Layout.astro";
import AuthForm from "../components/AuthForm";
---

<Layout title="Create an account - URL Shortener">
  <div class="mx-auto max-w-md">
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/60 sm:p-8">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
        Create your account
      </h1>
      <p class="mb-8 mt-2 text-sm leading-6 text-slate-600">
        Sign up to save and manage your short links.
      </p>
      <AuthForm mode="register" client:load />
    </section>
  </div>
</Layout>