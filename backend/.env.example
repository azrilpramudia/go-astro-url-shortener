# App
APP_NAME=go-astro-url-shortener
APP_BASE_URL=http://localhost:3000

# Web
WEB_PORT=3000
WEB_PREFORK=false
WEB_CORS_ORIGIN=http://localhost:4321

# Log (logrus level: 3=warn, 4=info, 5=debug, 6=trace)
LOG_LEVEL=5

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=url_shortener
DB_POOL_IDLE=10
DB_POOL_MAX=100
DB_POOL_LIFETIME=300

# Auth
JWT_SECRET=
JWT_TTL_HOURS=24
COOKIE_SECURE=false

# Rate limit
RATE_LIMIT_CREATE=20
RATE_LIMIT_AUTH=10